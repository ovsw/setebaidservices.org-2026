# Required local identity and Sanity connection values.
NEXT_PUBLIC_SITE_NAME="Setebaid Services"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3333
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-23
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
OG_IMAGE_SECRET=generate-a-long-random-value
SANITY_API_READ_TOKEN=your-read-token

# The Ask about camp form posts here. "echo" is Formspark's test endpoint:
# it answers without emailing the office. Vercel holds the real form ID.
FORMSPARK_FORM_ID=echo

# The form also goes, encrypted, to the Trigger.dev task that stores it in
# Neon. Without these two, only the Formspark path runs. The values are in
# the file that `pnpm setup:qr` keeps.
# TRIGGER_SECRET_KEY=
# FORM_ENCRYPTION_KEY=

# Optional editor tooling.
SHADCNBLOCKS_API_KEY=your-key
